FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-4-1 libgtksourceview-5-0 libwebkitgtk-6.0-4 xvfb xauth dbus-x11 xdotool imagemagick python3 util-linux bubblewrap librsvg2-bin librsvg2-common poppler-utils \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --shell /bin/bash fastra
