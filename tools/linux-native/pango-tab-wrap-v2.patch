+            return BREAK_NONE_FIT;
+          return BREAK_EMPTY_FIT;
+        }
       insert_run (line, state, item, NULL, TRUE);
       state->remaining_width -= width;
       state->remaining_width = MAX (state->remaining_width, 0);
