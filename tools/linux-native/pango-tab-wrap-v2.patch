@@ -4084,6 +4085,21 @@
 
   if (layout->text[item->offset] == '\t')
     {
+      /* Ein bestehendes Fragment darf vor einem weiteren Tab umbrechen.
+       * Das erste Graphem bleibt auch bei Ueberbreite auf seiner Zeile. */
+      if (line->runs && !no_break_at_end &&
+          layout->wrap != PANGO_WRAP_WORD &&
