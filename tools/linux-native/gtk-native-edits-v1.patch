+/* Der interaktive Plan unterstützt hier vollständig editierbare Bereiche.
+ * Geteilte Readonly-Bereiche werden im aktivierten Prototyp vor History abgewiesen. */
+static gboolean
+fastra_preflight_replace (GtkTextBuffer     *buffer,
+                          const GtkTextIter *first,
+                          const GtkTextIter *last,
+                          const char        *replacement,
+                          gboolean           default_editable)
+{
+  GtkTextIter start = *first, end = *last, at;
+  GVariantBuilder builder;
+  GVariant *plan;
+  gboolean veto = FALSE;
+  guint stamp;
+
+  if (!g_signal_has_handler_pending (buffer, signals[PREFLIGHT_EDITS], 0, TRUE))
+    return FALSE;
+  gtk_text_iter_order (&start, &end);
+  at = start;
+  while (gtk_text_iter_compare (&at, &end) < 0)
+    {
+      if (!gtk_text_iter_editable (&at, default_editable))
+        return TRUE;
+      if (!gtk_text_iter_forward_to_tag_toggle (&at, NULL))
+        break;
+    }
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(iis)"));
+  g_variant_builder_add (&builder, "(iis)", gtk_text_iter_get_offset (&start),
+                         gtk_text_iter_get_offset (&end), replacement);
+  plan = g_variant_ref_sink (g_variant_builder_end (&builder));
+  stamp = _gtk_text_btree_get_chars_changed_stamp (get_btree (buffer));
+  g_signal_emit (buffer, signals[PREFLIGHT_EDITS], 0, plan, &veto);
+  g_variant_unref (plan);
+  return veto || stamp != _gtk_text_btree_get_chars_changed_stamp (get_btree (buffer));
+}
