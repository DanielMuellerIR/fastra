+static gboolean
+action_is_undo_step (const Action *action)
+{
+  return action->kind != ACTION_KIND_BARRIER &&
+         (action->kind != ACTION_KIND_GROUP || !action_group_is_empty (action));
+}
+
 static void
 gtk_text_history_truncate (GtkTextHistory *self)
 {
+  guint levels = 0;
+  const GQueue *queues[] = { &self->undo_queue, &self->redo_queue };
+
   g_assert (GTK_IS_TEXT_HISTORY (self));
 
   if (self->max_undo_levels == 0)
     return;
 
-  while (self->undo_queue.length + self->redo_queue.length > self->max_undo_levels)
-    gtk_text_history_truncate_one (self);
+  /* Bound actual undo steps, not their barriers or an empty pending group. */
+  for (guint i = 0; i < G_N_ELEMENTS (queues); i++)
+    for (const GList *iter = queues[i]->head; iter != NULL; iter = iter->next)
+      levels += action_is_undo_step (iter->data);
+
+  while (levels > self->max_undo_levels)
+    {
+      Action *oldest = self->undo_queue.head != NULL
+                         ? self->undo_queue.head->data
+                         : self->redo_queue.tail->data;
+      gboolean step = action_is_undo_step (oldest);
+      gtk_text_history_truncate_one (self);
+      levels -= step;
+    }
+
+  /* A boundary cannot precede the first retained undo action. */
+  while (self->undo_queue.head != NULL)
+    {
+      Action *head = self->undo_queue.head->data;
+      if (head->kind != ACTION_KIND_BARRIER)
+        break;
+      g_queue_unlink (&self->undo_queue, &head->link);
+      action_free (head);
+    }
 }
 
