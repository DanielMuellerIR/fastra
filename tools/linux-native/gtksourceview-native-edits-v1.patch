 static gboolean
+fastra_smart_backspace (GtkSourceView *view, GtkTextIter *first, GtkTextIter *last,
+                        guint target_column, gboolean default_editable)
+{
+  GtkTextBuffer *buffer = gtk_text_iter_get_buffer (first);
+  guint signal = g_signal_lookup ("fastra-preflight-edits-v1", GTK_TYPE_TEXT_BUFFER);
+  GtkTextIter at = *first;
+  GVariantBuilder builder;
+  GVariant *plan;
+  gchar *spaces;
+  guint64 epoch;
+  gboolean veto = FALSE;
+
+  if (!signal || !g_signal_has_handler_pending (buffer, signal, 0, TRUE))
+    return FALSE;
+  while (gtk_text_iter_compare (&at, last) < 0)
+    {
+      if (!gtk_text_iter_editable (&at, default_editable))
+        return TRUE;
+      if (!gtk_text_iter_forward_to_tag_toggle (&at, NULL))
+        break;
+    }
+  spaces = g_strnfill (target_column - gtk_source_view_get_visual_column (view, first), ' ');
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(iis)"));
+  g_variant_builder_add (&builder, "(iis)", gtk_text_iter_get_offset (first),
+                         gtk_text_iter_get_offset (last), spaces);
+  plan = g_variant_ref_sink (g_variant_builder_end (&builder));
+  epoch = _gtk_source_buffer_fastra_mutation_epoch (GTK_SOURCE_BUFFER (buffer));
+  g_signal_emit (buffer, signal, 0, plan, &veto);
+  g_variant_unref (plan);
+  if (!veto && epoch == _gtk_source_buffer_fastra_mutation_epoch (GTK_SOURCE_BUFFER (buffer)))
+    {
+      /* Editierbarkeit und vollständiger Ersatz wurden vor der einzigen UserAction geprüft. */
+      gtk_text_buffer_begin_user_action (buffer);
+      gtk_text_buffer_delete (buffer, first, last);
+      gtk_text_buffer_insert (buffer, first, spaces, -1);
+      gtk_text_buffer_end_user_action (buffer);
+    }
+  g_free (spaces);
+  return TRUE;
+}
