+typedef struct {
+  gint start, end;
+  gboolean space;
+} FastraJoinEdit;
+
+/* Der vorhandene Join-Algorithmus wird zuerst mit unveränderten Iteratoren
+ * geplant. Die Ausführung verwendet genau diese ursprünglichen Bereiche. */
+static gboolean
+fastra_join_planned (GtkSourceBuffer *buffer, GtkTextIter *start, GtkTextIter *end)
+{
+  GtkTextBuffer *text = GTK_TEXT_BUFFER (buffer);
+  guint signal = g_signal_lookup ("fastra-preflight-edits-v1", GTK_TYPE_TEXT_BUFFER);
+  GtkTextIter cursor = *start, limit = *end, original_end;
+  GtkSourceBufferPrivate *priv = gtk_source_buffer_get_instance_private (buffer);
+  guint64 epoch;
+  GtkTextMark *end_mark;
+  GArray *edits;
+  GVariantBuilder builder;
+  GVariant *plan;
+  gboolean veto = FALSE, proven_oversize = FALSE;
+  guint line_bytes = 0, permanent_spaces = 0;
+  gint delta = 0, final_cursor, final_shift = 0;
+  guint i;
+
+  if (!signal || !g_signal_has_handler_pending (text, signal, 0, TRUE))
+    return FALSE;
+  if (g_object_class_find_property (G_OBJECT_GET_CLASS (text), "fastra-preflight-line-bytes-v1"))
+    g_object_get (text, "fastra-preflight-line-bytes-v1", &line_bytes, NULL);
+  gtk_text_iter_order (&cursor, &limit);
+  original_end = limit;
+  move_to_line_text_end (&cursor);
+  if (!gtk_text_iter_ends_line (&limit))
+    gtk_text_iter_forward_to_line_end (&limit);
+  edits = g_array_new (FALSE, FALSE, sizeof (FastraJoinEdit));
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(iis)"));
+  while (gtk_text_iter_compare (&cursor, &limit) < 0)
+    {
+      GtkTextIter scan = cursor;
+      FastraJoinEdit edit;
+      do {
+        if (!g_unichar_isspace (gtk_text_iter_get_char (&scan)))
+          break;
+      } while (gtk_text_iter_forward_char (&scan) &&
+               gtk_text_iter_compare (&scan, &limit) < 0);
+      if (gtk_text_iter_is_end (&scan))
+        break;
+      edit.start = gtk_text_iter_get_offset (&cursor);
+      edit.end = gtk_text_iter_get_offset (&scan);
+      edit.space = !gtk_text_iter_ends_line (&scan);
+      /* Nach Entfernen des CR ist dessen bisheriges LF selbst das Zeilenende.
+       * gtk_text_iter_ends_line beschreibt davor noch das unveränderte CRLF. */
+      if (gtk_text_iter_get_char (&scan) == '\n' && edit.end > edit.start)
+        edit.space = FALSE;
+      g_array_append_val (edits, edit);
+      g_variant_builder_add (&builder, "(iis)", edit.start, edit.end, edit.space ? " " : "");
+      /* Alle eingefügten Spaces bleiben zwischen Nutztext bestehen. Ohne Space
+       * endet der Plan; zusammenhängende Leerzeilen bilden nur einen Bereich.
+       * Deshalb ist die Liste auf Zeilenbytebudget + zwei Einträge begrenzt. */
+      if (edit.space && line_bytes && ++permanent_spaces > line_bytes)
+        { proven_oversize = TRUE; break; }
+      if (gtk_text_iter_get_char (&scan) != '\n' || gtk_text_iter_ends_line (&scan))
+        {
+          cursor = scan;
+          move_to_line_text_end (&cursor);
+        }
+      if (!edit.space || gtk_text_iter_get_offset (&original_end) <= edit.end)
+        break;
+      limit = original_end;
+    }
+  plan = g_variant_ref_sink (g_variant_builder_end (&builder));
+  epoch = priv->fastra_mutation_epoch;
+  g_signal_emit (text, signal, 0, plan, &veto);
+  g_variant_unref (plan);
+  if (veto || proven_oversize || epoch != priv->fastra_mutation_epoch || edits->len == 0)
+    { g_array_unref (edits); return TRUE; }
+
+  end_mark = gtk_text_buffer_create_mark (text, NULL, &original_end, FALSE);
+  _gtk_source_buffer_save_and_clear_selection (buffer);
+  gtk_text_buffer_begin_user_action (text);
+  final_cursor = gtk_text_iter_get_offset (&cursor);
+  for (i = 0; i < edits->len; i++)
+    {
+      FastraJoinEdit edit = g_array_index (edits, FastraJoinEdit, i);
+      if (final_cursor <= edit.start)
+        break;
+      if (final_cursor < edit.end)
+        { final_cursor = edit.start; break; }
+      final_shift += (edit.space ? 1 : 0) - (edit.end - edit.start);
+    }
+  final_cursor += final_shift;
+  for (i = 0; i < edits->len; i++)
+    {
+      FastraJoinEdit edit = g_array_index (edits, FastraJoinEdit, i);
+      GtkTextIter first, last;
+      gtk_text_buffer_get_iter_at_offset (text, &first, edit.start + delta);
+      gtk_text_buffer_get_iter_at_offset (text, &last, edit.end + delta);
+      gtk_text_buffer_delete (text, &first, &last);
+      if (edit.space)
+        gtk_text_buffer_insert (text, &first, " ", 1);
+      delta += (edit.space ? 1 : 0) - (edit.end - edit.start);
+    }
+  gtk_text_buffer_get_iter_at_offset (text, start, final_cursor);
+  gtk_text_buffer_get_iter_at_mark (text, end, end_mark);
+  gtk_text_buffer_end_user_action (text);
+  _gtk_source_buffer_restore_selection (buffer);
+  gtk_text_buffer_delete_mark (text, end_mark);
+  g_array_unref (edits);
+  return TRUE;
+}
